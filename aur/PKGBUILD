# Maintainer: britors <rodrigo@w3ti.com.br>
pkgname=postgres-draco
pkgver=1.1.1
pkgrel=1
pkgdesc="Database client of the Lyra OS ecosystem — schema explorer, SQL editor and administration for PostgreSQL"
arch=('x86_64')
url="https://github.com/britors/Draco"
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'gtksourceview5')
makedepends=('cargo' 'glib2-devel' 'desktop-file-utils' 'appstream-glib')
# 'draco' itself is taken by the official extra/draco (Google's 3D mesh
# compression library) — AUR forbids names colliding with official repo
# packages. 'draco-db' was this app's previous AUR name.
conflicts=('draco-db')
replaces=('draco-db')
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/britors/Draco/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "Draco-${pkgver}"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "Draco-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "Draco-${pkgver}"
    cargo test --frozen --release -p draco-core
}

package() {
    cd "Draco-${pkgver}"

    install -Dm755 "target/release/draco" "${pkgdir}/usr/bin/draco"
    install -Dm644 "data/org.lyraos.Draco.desktop" \
        "${pkgdir}/usr/share/applications/org.lyraos.Draco.desktop"
    install -Dm644 "data/org.lyraos.Draco.metainfo.xml" \
        "${pkgdir}/usr/share/metainfo/org.lyraos.Draco.metainfo.xml"
    install -Dm644 "data/icons/hicolor/1024x1024/apps/org.lyraos.Draco.png" \
        "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/org.lyraos.Draco.png"
    install -Dm644 "data/icons/hicolor/1024x1024/apps/org.lyraos.Draco-about.png" \
        "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/org.lyraos.Draco-about.png"
    install -Dm644 "data/icons/org.lyraos.Draco-symbolic.svg" \
        "${pkgdir}/usr/share/icons/hicolor/symbolic/apps/org.lyraos.Draco-symbolic.svg"
    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
