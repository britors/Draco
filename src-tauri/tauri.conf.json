{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Draco",
  "version": "2.0.3",
  "identifier": "org.lyraos.Draco",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Draco — PostgreSQL Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "PostgreSQL workbench",
    "icon": [
      "../data/icons/hicolor/1024x1024/apps/org.lyraos.Draco.png"
    ]
  }
}
