{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Draco",
  "version": "2.0.4",
  "identifier": "org.lyraos.Draco",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Draco — PostgreSQL Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "publisher": "Lyra OS",
    "homepage": "https://github.com/britors/Draco",
    "license": "GPL-3.0-or-later",
    "shortDescription": "PostgreSQL workbench",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["xdg-desktop-portal"]
      },
      "rpm": {
        "depends": ["xdg-desktop-portal"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
